<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome"
                    android:textColor="@color/brand_slate"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Checking GPS..."
                    android:textColor="@color/brand_slate_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Logout" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOutsideIndiaBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:text="@string/india_notice"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSosEmergency"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/emergency_red"
            android:text="SOS EMERGENCY ALERT"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/surface_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Weather (Open-Meteo)"
                android:textColor="@color/brand_slate"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWeatherSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Loading live weather..."
                android:textColor="@color/brand_slate_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAlertsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Monitoring meteorological conditions..."
                android:textColor="@color/info_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/cardLiveMap"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/brand_slate"
            android:text="Live Map &amp; Emergency Services"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/cardNearbyHospitals"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Nearby Hospitals" />

        <Button
            android:id="@+id/cardNearbyShelters"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Nearby Shelters &amp; Cyclone Shelters" />

        <Button
            android:id="@+id/cardWeather"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Detailed Weather &amp; Forecast" />

        <Button
            android:id="@+id/cardFamilySafety"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Family Safety &amp; Emergency Contacts" />

        <Button
            android:id="@+id/cardDisasterReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Report Disaster (Photo + GPS)" />

        <Button
            android:id="@+id/cardGuidelines"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Safety Guidelines" />

        <Button
            android:id="@+id/cardEmergencyServices"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Emergency Helpline Numbers (India)" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAiAssistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Open CycloneSafe AI Assistant"
        app:backgroundTint="#0284C7"
        app:elevation="8dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:srcCompat="@drawable/ic_ai_assistant"
        app:tint="@color/white" />
</FrameLayout>
