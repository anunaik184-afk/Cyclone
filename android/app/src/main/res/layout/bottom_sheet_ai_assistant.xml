<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_slate"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#0284C7"
            android:contentDescription="AI Assistant Icon"
            android:padding="5dp"
            android:src="@drawable/ic_ai_assistant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAssistantTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CycloneSafe AI Assistant"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preparedness, first aid &amp; India helpline guidance"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseAssistant"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="Close"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Quick Safety Prompts -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipCyclone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Cyclone checklist"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipFlood"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Flood safety"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipFirstAid"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="72-hr go-bag"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipHelplines"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="India helplines"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Conversation Thread -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp" />

    <TextView
        android:id="@+id/tvAssistantStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp"
        android:text="Thinking..."
        android:textColor="@color/brand_slate_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:hint="Ask about cyclone safety, shelters, or first aid..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0284C7"
            android:text="Send"
            android:textColor="@color/white"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
