<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".CycloneSafeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_cyclonesafe_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_cyclonesafe_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CycloneSafe"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.OtpVerificationActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.MapActivity" android:exported="false" />
        <activity android:name=".ui.WeatherActivity" android:exported="false" />
        <activity android:name=".ui.SosActivity" android:exported="false" />
        <activity android:name=".ui.ReportDisasterActivity" android:exported="false" />
        <activity android:name=".ui.FamilySafetyActivity" android:exported="false" />
        <activity android:name=".ui.GuidelinesActivity" android:exported="false" />
        <activity android:name=".ui.EmergencyServicesActivity" android:exported="false" />
    </application>

</manifest>
